# Required settings
PLEX_BASE_URL=http://127.0.0.1:32400
PLEX_TOKEN=your-plex-token
TMDB_API_KEY=your-tmdb-api-key

# Optional settings
# Comma-separated list of movie library names to include (leave blank for all)
PLEX_LIBRARY_NAMES=
# Set to true to preview changes without writing to Plex
DRY_RUN=false
# Number of movies per library to process in any mode (leave blank for no limit)
LIMIT_RUN_SIZE=
