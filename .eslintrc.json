{
	"extends": ["eslint:recommended", "plugin:prettier/recommended"],
	"env": {
		"es2021": true,
		"node": true
	},
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module"
	},
	"rules": {
		"padding-line-between-statements": [
			"error",
			{ "blankLine": "always", "prev": "*", "next": "block-like" },
			{ "blankLine": "always", "prev": "block-like", "next": "*" }
		]
	}
}
